{
  "manifest_version": 3,
  "name": "PocraEnd Helper",
  "version": "0.1.0",
  "description": "Reports active tabs to the PocraEnd desktop app.",
  "permissions": ["tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  }
}
